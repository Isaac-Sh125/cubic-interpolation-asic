###############################################################################
#  Innovus Design Globals - Fully Padded Top-Level Design (Section 6.4 Modified)
#  Target Node: TSMC 28nm (9LM 5X2Y1Z Configuration)
###############################################################################

# Netlist & Padded Top Level Wrapper Configuration
set init_verilog { ../datain/top.v }
set init_design_netlisttype {Verilog}
set init_design_settop 1
set init_top_cell {top}

# Hierarchical Character Mapping
set defHierChar {/}

# Power/Ground Net Definitions (Updated for TSMC 28nm Core & Pad Rings)
set init_pwr_net {VDDC VDDP POC}
set init_gnd_net {VSSC VSSP}

# I/O Pad Placement Configuration File (Crucial for Pad Integration)
set init_io_file {../datain/top.io}

# Physical LEF Files (Tech LEF, Standard Cell LEF, followed by I/O Pad LEF)
set init_lef_file { \
    /data/tsmc/28HPCPMMWAVE/dig_libs/techlef/PRTF_EDI_28nm_Cad_V19_1a/PR_tech/Cadence/LefHeader/HVH/tsmcn28_9lm5X2Y1RRDL.tlef \
    /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Back_End/lef/tcbn28hpcplusbwp30p140_110a/lef/tcbn28hpcplusbwp30p140.lef \
    /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Back_End/lef/tphn28hpcpgv18_110a/mt_2/9lm/lef/tphn28hpcpgv18_9lm.lef \
    /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Back_End/lef/tpbn28v_140b/cup/9m/9M_5X2Y1Z/lef/tpbn28v_9lm.lef \
}

# MMMC Configuration View Script
set init_mmmc_file { ../datain/mmmc.view }

# Additional Import Parameters
set init_abstract_view {abstract}
set init_layout_view {layout}
set init_import_mode { -keepEmptyModule 0 -treatUndefinedCellAsBbox 0 }
