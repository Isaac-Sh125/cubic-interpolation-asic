# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line

# -----------------------------------------------------------------------------
# RC Corners (Parasitic Extraction Scenarios)
# -----------------------------------------------------------------------------
create_rc_corner -name SlowRC -T {125} -preRoute_res {1} -preRoute_cap {1} -preRoute_clkres {0} -preRoute_clkcap {0} -postRoute_res {1} -postRoute_cap {1} -postRoute_xcap {1} -postRoute_clkres {0} -postRoute_clkcap {0} -qx_tech_file {/data/tsmc/28HPCPMMWAVE/QRC/1.8a/9m/cworst/qrcTechFile}
create_rc_corner -name FastRC -T {-40} -preRoute_res {1} -preRoute_cap {1} -preRoute_clkres {0} -preRoute_clkcap {0} -postRoute_res {1} -postRoute_cap {1} -postRoute_xcap {1} -postRoute_clkres {0} -postRoute_clkcap {0} -qx_tech_file {/data/tsmc/28HPCPMMWAVE/QRC/1.8a/9m/cbest/qrcTechFile}

# -----------------------------------------------------------------------------
# Library Sets (Combining Core Cells and IO Pads for each PVT)
# -----------------------------------------------------------------------------
# Typical Corner (tt)
create_library_set -name Typ -timing { \
  /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tcbn28hpcplusbwp30p140_180a/tcbn28hpcplusbwp30p140tt0p9v25c.lib \
  /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tphn28hpcpgv18_170a/tphn28hpcpgv18tt0p9v1p8v25c.lib \
}

# Best Case / Fast Corner (ff)
create_library_set -name Min -timing { \
  /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tcbn28hpcplusbwp30p140_180a/tcbn28hpcplusbwp30p140ffg0p99vm40c.lib \
  /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tphn28hpcpgv18_170a/tphn28hpcpgv18ffg0p99v1p98vm40c.lib \
}

# Worst Case / Slow Corner (ss)
create_library_set -name Max -timing { \
  /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tcbn28hpcplusbwp30p140_180a/tcbn28hpcplusbwp30p140ssg0p81v125c.lib \
  /data/tsmc/28HPCPMMWAVE/dig_libs/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tphn28hpcpgv18_170a/tphn28hpcpgv18ssg0p81v1p62v125c.lib \
}

# -----------------------------------------------------------------------------
# Constraint Modes, Delay Corners, and Analysis Views
# -----------------------------------------------------------------------------
create_constraint_mode -name TypCM -sdc_files {/project/verif/users/yitzhak2/ws/ex_vlsi_1/final_script/innovus/datain/top.sdc /project/verif/users/yitzhak2/ws/ex_vlsi_1/final_script/innovus/datain/extra_constraints.sdc}

create_delay_corner -name SlowDC -library_set {Max} -rc_corner {SlowRC}
create_delay_corner -name FastDC -library_set {Min} -rc_corner {FastRC}

create_analysis_view -name FastView -constraint_mode {TypCM} -delay_corner {FastDC}
create_analysis_view -name SlowView -constraint_mode {TypCM} -delay_corner {SlowDC}

set_analysis_view -setup {SlowView} -hold {FastView}
